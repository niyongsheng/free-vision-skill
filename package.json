{
  "name": "@niyongsheng/free-vision-skill",
  "version": "0.3.1",
  "description": "DSH-Plugin for DeepSeek-Harness: fully-local image understanding & OCR powered by macOS Vision Framework",
  "type": "module",
  "main": "./dist/cordis/index.js",
  "types": "./dist/cordis/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cordis/index.d.ts",
      "import": "./dist/cordis/index.js"
    },
    "./client": "./dist/cordis/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/smoke.mjs"
  },
  "cordis": {
    "name": "free-vision-skill",
    "config": "Config"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "vision",
    "ocr"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@cordisjs/core": "^3.18.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@cordisjs/core": "^3.18.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
